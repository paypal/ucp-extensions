{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-10-08/google_pay_instrument.json",
  "title": "PayPal Unified Payments google_pay Instrument",
  "description": "The google_pay instrument forwarded on /complete. Carries the Google Pay ECv2 token, passed through unchanged.",
  "allOf": [
    {
      "$ref": "https://ucp.dev/2026-08-25/schemas/common/types/payment_instrument.json"
    },
    {
      "type": "object",
      "required": [
        "id",
        "handler_id",
        "type",
        "credential"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "handler_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "google_pay"
        },
        "credential": {
          "$ref": "google_pay_token_credential.json"
        }
      }
    }
  ],
  "examples": [
    {
      "id": "instr_1",
      "handler_id": "unified-paypal-handler",
      "type": "google_pay",
      "selected": true,
      "credential": {
        "type": "google_pay_token",
        "token": "{\"signature\":\"...\",\"protocolVersion\":\"ECv2\",\"signedMessage\":\"...\"}"
      }
    }
  ]
}
