{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-09/apple_pay_instrument.json",
  "title": "PayPal Unified Payments apple_pay Instrument",
  "description": "The apple_pay instrument forwarded on /complete. Carries the encrypted Apple Pay payment token, passed through unchanged.",
  "allOf": [
    {
      "$ref": "https://ucp.dev/2026-08-25/schemas/common/types/payment_instrument.json"
    },
    {
      "type": "object",
      "required": [
        "id",
        "handler_id",
        "type",
        "credential"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "handler_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "apple_pay"
        },
        "credential": {
          "$ref": "apple_pay_token_credential.json"
        }
      }
    }
  ],
  "examples": [
    {
      "id": "instr_1",
      "handler_id": "unified-paypal-handler",
      "type": "apple_pay",
      "selected": true,
      "credential": {
        "type": "apple_pay_token",
        "token": "<apple pay encrypted payment token>"
      }
    }
  ]
}
