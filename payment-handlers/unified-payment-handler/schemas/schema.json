{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-22/schema.json",
  "title": "PayPal Universal Payment Handler",
  "description": "Schema for the com.paypal.payments payment handler. One handler advertises four instruments — card, paypal, google_pay, apple_pay — each with its own per-instrument config and credential.",
  "name": "com.paypal.payments",
  "version": "2026-09-22",
  "spec": "https://payments.paypal.com/ucp/payment-handlers/2026-09-22/",
  "schema": "https://payments.paypal.com/ucp/payment-handlers/2026-09-22/schema.json",
  "endpoints": {
    "tokenize": "/ucp/v1/tokenize"
  },
  "available_instruments": [
    {
      "type": "card",
      "constraints": {
        "brands": [
          "visa",
          "mastercard",
          "amex",
          "discover",
          "jcb",
          "diners",
          "elo",
          "hiper",
          "hipercard",
          "maestro",
          "switch",
          "solo",
          "unionpay"
        ],
        "tokenization": "required"
      }
    },
    {
      "type": "paypal",
      "config": {
        "$ref": "paypal_config.json"
      }
    },
    {
      "type": "google_pay",
      "config": {
        "$ref": "https://pay.google.com/gp/p/ucp/2026-01-23/schemas/config.json"
      }
    },
    {
      "type": "apple_pay",
      "config": {
        "$ref": "apple_pay_config.json"
      }
    }
  ],
  "$defs": {
    "business_config": {
      "title": "PayPal Universal Payment Handler Business Configuration",
      "description": "Handler-level config advertised by a merchant using the PayPal Universal Payment Handler. Carries only the payee identity; per-instrument material lives in each instrument's config.",
      "type": "object",
      "required": [
        "environment",
        "merchant_id"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "production"
          ]
        },
        "merchant_id": {
          "type": "string",
          "minLength": 1,
          "description": "The merchant's PayPal Merchant ID — the payee the captured order settles to."
        }
      },
      "additionalProperties": false
    },
    "tokenize_request": {
      "$ref": "tokenize_request.json"
    },
    "tokenize_response": {
      "$ref": "tokenize_response.json"
    },
    "nonce_credential": {
      "$ref": "nonce_credential.json"
    },
    "approval_token_credential": {
      "$ref": "../../common/schemas/approval_token_credential.json"
    },
    "google_pay_token_credential": {
      "$ref": "google_pay_token_credential.json"
    },
    "apple_pay_token_credential": {
      "$ref": "apple_pay_token_credential.json"
    },
    "paypal_config": {
      "$ref": "paypal_config.json"
    },
    "google_pay_config": {
      "$ref": "https://pay.google.com/gp/p/ucp/2026-01-23/schemas/config.json"
    },
    "apple_pay_config": {
      "$ref": "apple_pay_config.json"
    },
    "card_instrument": {
      "$ref": "payment_instrument.json"
    },
    "paypal_instrument": {
      "$ref": "paypal_instrument.json"
    },
    "google_pay_instrument": {
      "$ref": "google_pay_instrument.json"
    },
    "apple_pay_instrument": {
      "$ref": "apple_pay_instrument.json"
    },
    "com.paypal.payments": {
      "payment_instrument": {
        "oneOf": [
          {
            "$ref": "payment_instrument.json"
          },
          {
            "$ref": "paypal_instrument.json"
          },
          {
            "$ref": "google_pay_instrument.json"
          },
          {
            "$ref": "apple_pay_instrument.json"
          }
        ]
      },
      "business_schema": {
        "title": "PayPal Universal Payment Handler (Business)",
        "description": "Business-level handler configuration for merchant discovery.",
        "allOf": [
          {
            "$ref": "https://ucp.dev/2026-08-25/schemas/payment_handler.json#/$defs/business_schema"
          },
          {
            "type": "object",
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "$ref": "#/$defs/business_config"
              }
            }
          }
        ]
      }
    }
  }
}
