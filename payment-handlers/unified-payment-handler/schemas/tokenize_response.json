{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-09/tokenize_response.json",
  "title": "PayPal Unified Payments Tokenize Response",
  "description": "Response containing a PayPal payment token scoped to the requested binding and merchant identity.",
  "type": "object",
  "required": [
    "type",
    "token",
    "expires_at"
  ],
  "properties": {
    "type": {
      "const": "paypal_payment_token",
      "description": "PayPal payment-token type discriminator."
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque, single-use payment token."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Token expiration in RFC 3339 format. Tokens expire no later than 15 minutes after issuance."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "paypal_payment_token",
      "token": "PAYPAL-TEST-TOKEN-123",
      "expires_at": "2026-09-10T15:15:00Z"
    }
  ]
}
