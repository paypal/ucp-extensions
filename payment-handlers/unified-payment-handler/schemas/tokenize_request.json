{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-22/tokenize_request.json",
  "title": "PayPal Unified Payments Tokenize Request",
  "description": "Request to tokenize a card for the card instrument of the PayPal Universal Payment Handler. The agent's PSP calls this and forwards the resulting nonce on /complete; a raw PAN is never sent to the merchant.",
  "type": "object",
  "required": [
    "credential",
    "binding"
  ],
  "properties": {
    "credential": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/2026-08-25/schemas/common/types/pan_credential.json"
        },
        {
          "type": "object",
          "required": [
            "type",
            "card_number_type",
            "number",
            "expiry_month",
            "expiry_year"
          ],
          "properties": {
            "type": {
              "const": "card"
            },
            "card_number_type": {
              "type": "string",
              "enum": [
                "fpan",
                "network_token",
                "dpan"
              ],
              "description": "Format of `number`. Network tokens are preferred with fallback to FPAN."
            },
            "expiry_month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "expiry_year": {
              "type": "integer",
              "minimum": 2026
            },
            "cryptogram": {
              "type": "string",
              "description": "Provided with network tokens (card_number_type: \"network_token\")."
            },
            "eci_value": {
              "type": "string",
              "description": "Provided with network tokens (card_number_type: \"network_token\")."
            }
          }
        }
      ]
    },
    "binding": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/2026-08-25/schemas/common/types/binding.json"
        },
        {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "dev.ucp.shopping.checkout"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The checkout session this token is scoped to. Binds the token so it can't be replayed on another checkout."
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "credential": {
        "type": "card",
        "card_number_type": "fpan",
        "number": "4111111111111111",
        "expiry_month": 4,
        "expiry_year": 2028,
        "cvc": "123",
        "name": "Jane Doe"
      },
      "binding": {
        "type": "dev.ucp.shopping.checkout",
        "id": "<checkout_id>"
      }
    }
  ]
}
