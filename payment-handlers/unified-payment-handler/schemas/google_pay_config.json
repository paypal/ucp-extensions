{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-09/google_pay_config.json",
  "title": "PayPal Unified Payments — google_pay Instrument Config",
  "description": "Per-instrument config for the google_pay instrument. Follows Google's Google Pay API request shape so the agent can build the payment sheet directly.",
  "type": "object",
  "required": [
    "api_version",
    "api_version_minor",
    "environment",
    "merchant_info",
    "allowed_payment_methods"
  ],
  "properties": {
    "api_version": {
      "type": "integer",
      "description": "Google Pay API major version the sheet targets."
    },
    "api_version_minor": {
      "type": "integer",
      "description": "Google Pay API minor version the sheet targets."
    },
    "environment": {
      "type": "string",
      "enum": [
        "PRODUCTION",
        "TEST"
      ]
    },
    "merchant_info": {
      "type": "object",
      "required": [
        "merchant_name",
        "merchant_id"
      ],
      "properties": {
        "merchant_name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name shown in the Google Pay sheet."
        },
        "merchant_id": {
          "type": "string",
          "minLength": 1,
          "description": "Google Pay merchant id (required in PRODUCTION)."
        },
        "merchant_origin": {
          "type": "string",
          "description": "The origin the sheet is presented from."
        }
      },
      "additionalProperties": false
    },
    "allowed_payment_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "parameters",
          "tokenization_specification"
        ],
        "properties": {
          "type": {
            "const": "CARD"
          },
          "parameters": {
            "type": "object",
            "required": [
              "allowed_auth_methods",
              "allowed_card_networks"
            ],
            "properties": {
              "allowed_auth_methods": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "PAN_ONLY",
                    "CRYPTOGRAM_3DS"
                  ]
                }
              },
              "allowed_card_networks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "tokenization_specification": {
            "type": "object",
            "required": [
              "type",
              "parameters"
            ],
            "properties": {
              "type": {
                "const": "PAYMENT_GATEWAY"
              },
              "parameters": {
                "type": "object",
                "required": [
                  "gateway",
                  "gatewayMerchantId"
                ],
                "properties": {
                  "gateway": {
                    "const": "paypalppcp",
                    "description": "Routes the token to PayPal. Must not be changed; it is what makes the resulting ECv2 token one PayPal Orders can ingest."
                  },
                  "gatewayMerchantId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The merchant's PayPal Merchant ID."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "api_version": 2,
      "api_version_minor": 0,
      "environment": "PRODUCTION",
      "merchant_info": {
        "merchant_name": "Example Merchant",
        "merchant_id": "<google_pay_merchant_id>",
        "merchant_origin": "checkout.merchant.com"
      },
      "allowed_payment_methods": [
        {
          "type": "CARD",
          "parameters": {
            "allowed_auth_methods": ["PAN_ONLY", "CRYPTOGRAM_3DS"],
            "allowed_card_networks": ["AMEX", "DISCOVER", "JCB", "MASTERCARD", "VISA"]
          },
          "tokenization_specification": {
            "type": "PAYMENT_GATEWAY",
            "parameters": {
              "gateway": "paypalppcp",
              "gatewayMerchantId": "<paypal_merchant_id>"
            }
          }
        }
      ]
    }
  ]
}
