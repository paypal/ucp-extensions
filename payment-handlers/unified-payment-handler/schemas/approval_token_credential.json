{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-09/approval_token_credential.json",
  "title": "PayPal Unified Payments Approval Token Credential",
  "description": "PayPal approval token forwarded for the paypal instrument. Captured via PayPal Orders v2 as payment_source.token with type APPROVAL.",
  "allOf": [
    {
      "$ref": "https://ucp.dev/2026-08-25/schemas/common/types/token_credential.json"
    },
    {
      "type": "object",
      "required": [
        "type",
        "token"
      ],
      "properties": {
        "type": {
          "const": "approval_token",
          "description": "PayPal approval-token type discriminator."
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "Single-use PayPal approval token id, scoped to a fixed amount, currency, and payee."
        }
      }
    }
  ],
  "examples": [
    {
      "type": "approval_token",
      "token": "1AB23456CD789012E"
    }
  ]
}
