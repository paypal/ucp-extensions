{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payments.paypal.com/ucp/payment-handlers/2026-09-09/nonce_credential.json",
  "title": "PayPal Unified Payments Nonce Credential",
  "description": "Single-use card nonce produced by the PayPal tokenizer and submitted in a UCP card payment instrument on /complete.",
  "allOf": [
    {
      "$ref": "https://ucp.dev/2026-08-25/schemas/common/types/token_credential.json"
    },
    {
      "type": "object",
      "required": [
        "type",
        "token"
      ],
      "properties": {
        "type": {
          "const": "nonce",
          "description": "Card nonce type discriminator."
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque, single-use nonce bound to the checkout it was minted for."
        }
      }
    }
  ],
  "examples": [
    {
      "type": "nonce",
      "token": "nonce_test_123"
    }
  ]
}
